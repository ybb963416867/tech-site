{
  "name": "my-tech-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean:cache": "node scripts/clean-generated.mjs",
    "clean:build": "node scripts/clean-generated.mjs --dist",
    "posts:normalize": "node scripts/normalize-posts.mjs",
    "content:check-assets": "node scripts/check-content-assets.mjs",
    "dev": "node scripts/dev-server.mjs",
    "build": "npm run clean:build && npm run posts:normalize && npm run content:check-assets && ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run clean:cache && npm run posts:normalize && npm run content:check-assets && ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "@pagefind/default-ui": "^1.3.0",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.3.1",
    "astro": "^5.9.3",
    "@lucide/astro": "^0.511.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "pagefind": "^1.3.0",
    "typescript": "^5.8.3"
  }
}
