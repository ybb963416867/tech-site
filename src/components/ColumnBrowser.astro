---
import type { CollectionEntry } from 'astro:content';
import type { Column } from '../lib/posts';
import { getPostColumnNames, getPostColumnSlugs } from '../lib/posts';

interface Props {
  activeSlugs?: string[];
  allPosts: CollectionEntry<'blog'>[];
  columns: Column[];
  posts: CollectionEntry<'blog'>[];
  subtitle: string;
  title: string;
}

type TreeRow =
  | {
      type: 'folder';
      name: string;
      href: string;
      depth: number;
      count: number;
      active: boolean;
      open: boolean;
      key: string;
      parentKey: string;
      hasChildren: boolean;
    }
  | {
      type: 'post';
      name: string;
      href: string;
      depth: number;
      active: boolean;
      key: string;
      parentKey: string;
    };

const { activeSlugs = [], allPosts, columns, posts, subtitle, title } = Astro.props;
const activeKey = activeSlugs.join('/');
const postGroups = new Map<string, CollectionEntry<'blog'>[]>();

for (const post of allPosts) {
  const key = getPostColumnSlugs(post).join('/');
  const group = postGroups.get(key) || [];
  group.push(post);
  postGroups.set(key, group);
}

function makeHref(slugs: string[]) {
  return `/categories/${slugs.map((slug) => encodeURIComponent(slug)).join('/')}/`;
}

function makeMobilePostHref(post: CollectionEntry<'blog'>) {
  const params = new URLSearchParams({
    from: 'mobile-category',
    back: activeSlugs.length > 0 ? makeHref(activeSlugs) : '/categories/',
    title: mobileTitle
  });

  return `/blog/${post.slug}/?${params.toString()}`;
}

function isOpen(slugs: string[]) {
  if (!activeKey) return false;
  const key = slugs.join('/');
  return activeKey === key || activeKey.startsWith(`${key}/`);
}

function flattenColumns(items: Column[], parentSlugs: string[] = [], depth = 0) {
  const rows: TreeRow[] = [];
  const parentKey = parentSlugs.join('/');

  for (const item of items) {
    const slugs = [...parentSlugs, item.slug];
    const key = slugs.join('/');
    const open = isOpen(slugs);
    const directPosts = postGroups.get(key) || [];

    rows.push({
      type: 'folder',
      name: item.name,
      href: makeHref(slugs),
      depth,
      count: item.count,
      active: activeKey === key,
      open,
      key,
      parentKey,
      hasChildren: item.children.length > 0 || directPosts.length > 0
    });

    rows.push(...flattenColumns(item.children, slugs, depth + 1));

    for (const post of directPosts) {
      rows.push({
        type: 'post',
        name: post.data.title,
        href: `/blog/${post.slug}/`,
        depth: depth + 1,
        active: false,
        key: `${key}::${post.id}`,
        parentKey: key
      });
    }
  }

  return rows;
}

const treeRows = flattenColumns(columns);
const totalColumns = columns.length;
const totalPosts = allPosts.length;

function findColumn(items: Column[], slugs: string[]): Column | undefined {
  if (slugs.length === 0) return undefined;
  let currentItems = items;
  let current: Column | undefined;

  for (const slug of slugs) {
    current = currentItems.find((item) => item.slug === slug);
    if (!current) return undefined;
    currentItems = current.children;
  }

  return current;
}

function latestDateForPrefix(slugs: string[]) {
  const dates = allPosts
    .filter((post) => {
      const postSlugs = getPostColumnSlugs(post);
      return slugs.every((slug, index) => postSlugs[index] === slug);
    })
    .map((post) => post.data.pubDate.valueOf());

  if (dates.length === 0) return '';

  return new Date(Math.max(...dates)).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  });
}

const activeColumn = findColumn(columns, activeSlugs);
const mobileTitle = activeSlugs.length > 0 ? activeSlugs[activeSlugs.length - 1] : '全部笔记';
const mobileFolders = activeColumn ? activeColumn.children : columns;
const mobilePosts = postGroups.get(activeKey) || [];
const parentHref =
  activeSlugs.length > 1
    ? makeHref(activeSlugs.slice(0, -1))
    : activeSlugs.length === 1
      ? '/categories/'
      : '/';
---

<section class="mobile-file-browser" aria-label={`${mobileTitle} 文件列表`}>
  <header class="mobile-file-header">
    <a class="mobile-file-icon-button" href={parentHref} aria-label="返回上一级">
      <span class="mobile-back-icon" aria-hidden="true"></span>
    </a>
    <h1>{mobileTitle}</h1>
    <a class="mobile-file-icon-button" href="/blog/" aria-label="文章归档">
      <span class="mobile-more-icon" aria-hidden="true"></span>
    </a>
  </header>

  <div class="mobile-file-rule" aria-hidden="true"></div>

  <div class="mobile-file-list">
    {
      mobileFolders.map((folder) => {
        const slugs = [...activeSlugs, folder.slug];
        return (
          <a class="mobile-file-card folder" href={makeHref(slugs)}>
            <span class="mobile-folder-icon" aria-hidden="true"></span>
            <span class="mobile-file-content">
              <strong>{folder.name}</strong>
              <span>{latestDateForPrefix(slugs) || `${folder.count} 篇笔记`}</span>
            </span>
          </a>
        );
      })
    }

    {mobileFolders.length > 0 && mobilePosts.length > 0 && <p class="mobile-file-section">笔记</p>}

    {
      mobilePosts.map((post) => {
        const date = post.data.pubDate.toLocaleDateString('zh-CN', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit'
        });

        return (
          <a class="mobile-file-card note" href={makeMobilePostHref(post)}>
            <span class="mobile-note-icon" aria-hidden="true">M</span>
            <span class="mobile-file-content">
              <strong>{post.data.title}</strong>
              <span class="mobile-file-desc">{post.data.description}</span>
              <span>{date}</span>
            </span>
          </a>
        );
      })
    }

    {mobileFolders.length === 0 && mobilePosts.length === 0 && <p class="mobile-file-empty">这个目录暂时没有笔记。</p>}
  </div>
</section>

<section class="knowledge-shell">
  <aside class="knowledge-sidebar" aria-label="专栏目录">
    <div class="sidebar-head">
      <a href="/categories/">全部笔记</a>
      <span>{totalPosts}</span>
    </div>
    <nav class="column-tree">
      {
        treeRows.map((row) =>
          row.type === 'folder' ? (
            <div
              class:list={['tree-row', 'tree-folder-row', { active: row.active }]}
              style={`--depth: ${row.depth}`}
              data-tree-row
              data-key={row.key}
              data-parent={row.parentKey}
              data-open={row.open ? 'true' : 'false'}
            >
              <button
                class="tree-toggle"
                type="button"
                aria-label={`${row.open ? '收起' : '展开'} ${row.name}`}
                aria-expanded={row.open ? 'true' : 'false'}
                disabled={!row.hasChildren}
              >
                <span class:list={['tree-caret', { open: row.open }]} aria-hidden="true"></span>
              </button>
              <a class="tree-folder-link" href={row.href}>
                <span class="tree-folder-icon" aria-hidden="true"></span>
                <span class="tree-name">{row.name}</span>
                <span class="tree-count">{row.count}</span>
              </a>
            </div>
          ) : (
            <a
              class="tree-row tree-post"
              href={row.href}
              style={`--depth: ${row.depth}`}
              data-tree-row
              data-key={row.key}
              data-parent={row.parentKey}
            >
              <span class="tree-doc-icon" aria-hidden="true"></span>
              <span class="tree-name">{row.name}</span>
            </a>
          )
        )
      }
    </nav>
  </aside>

  <section class="knowledge-main">
    <header class="knowledge-toolbar">
      <div>
        <p class="eyebrow">Columns / {totalColumns}</p>
        <h1>{title}</h1>
        <p>{subtitle}</p>
      </div>
      <a class="toolbar-action" href="/blog/">文章归档</a>
    </header>

    <div class="note-grid" aria-label={`${title} 文章列表`}>
      {
        posts.map((post) => {
          const column = getPostColumnNames(post).join(' / ');
          const date = post.data.pubDate.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
          });

          return (
            <a class="note-card" href={`/blog/${post.slug}/`}>
              <span class="note-column">{column}</span>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="note-date">{date}</span>
            </a>
          );
        })
      }
    </div>
  </section>
</section>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-tree-row]'));
  const rowByKey = new Map(rows.map((row) => [row.dataset.key || '', row]));

  function isVisible(row: HTMLElement) {
    let parentKey = row.dataset.parent || '';

    while (parentKey) {
      const parent = rowByKey.get(parentKey);
      if (!parent || parent.dataset.open !== 'true') return false;
      parentKey = parent.dataset.parent || '';
    }

    return true;
  }

  function syncTree() {
    for (const row of rows) {
      row.hidden = !isVisible(row);
      const button = row.querySelector<HTMLButtonElement>('.tree-toggle');
      const caret = row.querySelector<HTMLElement>('.tree-caret');

      if (button && caret) {
        const open = row.dataset.open === 'true';
        button.setAttribute('aria-expanded', open ? 'true' : 'false');
        button.setAttribute('aria-label', `${open ? '收起' : '展开'} ${row.querySelector('.tree-name')?.textContent || ''}`);
        caret.classList.toggle('open', open);
      }
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.tree-toggle')) {
    button.addEventListener('click', () => {
      const row = button.closest<HTMLElement>('[data-tree-row]');
      if (!row) return;
      row.dataset.open = row.dataset.open === 'true' ? 'false' : 'true';
      syncTree();
    });
  }

  syncTree();
</script>
