---
import type { CollectionEntry } from 'astro:content';
import { getPostColumnNames } from '../lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const column = getPostColumnNames(post).join(' / ');
const date = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
});
const searchText = [
  post.data.title,
  post.data.description,
  column,
  post.slug,
  ...post.data.tags
].join(' ');
---

<a class="post-card" href={`/blog/${post.slug}/`} data-post-card data-search-text={searchText}>
  <time class="post-date" datetime={post.data.pubDate.toISOString()}>{date}</time>
  <div>
    <h2>{post.data.title}</h2>
    <p>{post.data.description}</p>
    <div class="tag-row" aria-label="Meta">
      <span class="tag">{column}</span>
      {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
    </div>
  </div>
</a>
