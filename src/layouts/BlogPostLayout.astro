---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    category: string;
    tags: string[];
  };
  headings: MarkdownHeading[];
  columnNames?: string[];
  columnSlugs?: string[];
}

const { columnNames = [Astro.props.frontmatter.category], columnSlugs = columnNames, frontmatter, headings } = Astro.props;
const pubDate = frontmatter.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
});
const columnLabel = columnNames.join(' / ');
const columnHref = `/categories/${columnSlugs.map((slug) => encodeURI(slug)).join('/')}/`;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} type="article">
  <header class="mobile-post-return" data-mobile-post-return hidden>
    <a class="mobile-file-icon-button" href="/categories/" data-mobile-post-back aria-label="返回笔记目录">
      <span class="mobile-back-icon" aria-hidden="true"></span>
    </a>
    <h1 data-mobile-post-title>笔记</h1>
    <a class="mobile-file-icon-button" href="/blog/" aria-label="文章归档">
      <span class="mobile-more-icon" aria-hidden="true"></span>
    </a>
  </header>
  <div class="mobile-file-rule mobile-post-rule" data-mobile-post-return-rule hidden aria-hidden="true"></div>

  <article class="shell" data-pagefind-body>
    <header class="post-hero">
      <p class="eyebrow">Article / {pubDate}</p>
      <h1>{frontmatter.title}</h1>
      <p>{frontmatter.description}</p>
      <div class="tag-row">
        <a class="tag" href={columnHref}>{columnLabel}</a>
        {frontmatter.tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
      </div>
    </header>
    <div class="post-shell">
      <div>
        <div class="prose">
          <slot />
        </div>
        <section class="comments" aria-label="Comments">
          <Giscus />
        </section>
      </div>
      <TOC headings={headings} />
    </div>
  </article>

  <script is:inline>
    const params = new URLSearchParams(window.location.search);

    if (params.get('from') === 'mobile-category') {
      document.body.classList.add('from-mobile-file');

      const title = params.get('title') || '笔记';
      const back = params.get('back') || '/categories/';
      const header = document.querySelector('[data-mobile-post-return]');
      const rule = document.querySelector('[data-mobile-post-return-rule]');
      const backLink = document.querySelector('[data-mobile-post-back]');
      const titleNode = document.querySelector('[data-mobile-post-title]');

      header?.removeAttribute('hidden');
      rule?.removeAttribute('hidden');

      if (backLink instanceof HTMLAnchorElement) {
        backLink.href = back;
      }

      if (titleNode) {
        titleNode.textContent = title;
      }
    }
  </script>
</BaseLayout>
