---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import Giscus from '../components/Giscus.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    category: string;
    tags: string[];
  };
  headings: MarkdownHeading[];
}

const { frontmatter, headings } = Astro.props;
const pubDate = frontmatter.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
});
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} type="article">
  <article class="shell" data-pagefind-body>
    <header class="post-hero">
      <p class="eyebrow">Article / {pubDate}</p>
      <h1>{frontmatter.title}</h1>
      <p>{frontmatter.description}</p>
      <div class="tag-row">
        <a class="tag" href={`/categories/${encodeURIComponent(frontmatter.category)}/`}>{frontmatter.category}</a>
        {frontmatter.tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
      </div>
    </header>
    <div class="post-shell">
      <div>
        <div class="prose">
          <slot />
        </div>
        <section class="comments" aria-label="Comments">
          <Giscus />
        </section>
      </div>
      <TOC headings={headings} />
    </div>
  </article>
</BaseLayout>
