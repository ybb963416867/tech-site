---
import { type CollectionEntry } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getPostColumnNames, getPostColumnSlugs, getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const columnNames = getPostColumnNames(post);
const columnSlugs = getPostColumnSlugs(post);
---

<BlogPostLayout frontmatter={post.data} headings={headings} columnNames={columnNames} columnSlugs={columnSlugs}>
  <Content />
</BlogPostLayout>
