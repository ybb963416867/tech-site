---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSearchList from '../../components/ArticleSearchList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout title="文章" description="全部技术文章归档。">
  <section class="shell hero">
    <div>
      <p class="eyebrow">Archive</p>
      <h1>文章</h1>
      <p>所有 Markdown 文章会自动出现在这里，按发布时间倒序排列。</p>
    </div>
  </section>
  <ArticleSearchList posts={posts} searchLabel="搜索文章" listLabel="全部文章" />
</BaseLayout>
