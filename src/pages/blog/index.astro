---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout title="文章" description="全部技术文章归档。">
  <section class="shell hero">
    <div>
      <p class="eyebrow">Archive</p>
      <h1>文章</h1>
      <p>所有 Markdown 文章会自动出现在这里，按发布时间倒序排列。</p>
    </div>
  </section>
  <section class="shell archive-search" aria-label="文章搜索">
    <label class="archive-search-box">
      <span>搜索文章</span>
      <input
        type="search"
        placeholder="输入 OpenAI Codex CLI、Swift、Git..."
        autocomplete="off"
        data-archive-search
      />
    </label>
    <div class="archive-search-actions">
      <p class="archive-search-meta" data-archive-search-meta>共 {posts.length} 篇文章</p>
      <button class="archive-search-reset" type="button" data-archive-search-reset disabled>显示全部</button>
    </div>
  </section>
  <section class="shell post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
  <p class="shell archive-empty" data-archive-empty hidden>没有找到匹配的文章。</p>
  <script>
    const input = document.querySelector('[data-archive-search]');
    const meta = document.querySelector('[data-archive-search-meta]');
    const reset = document.querySelector('[data-archive-search-reset]');
    const empty = document.querySelector('[data-archive-empty]');
    const cards = Array.from(document.querySelectorAll('[data-post-card]'));
    const normalize = (value: string) =>
      value
        .toLocaleLowerCase()
        .normalize('NFKC')
        .replace(/[-_/]+/g, ' ')
        .replace(/\\s+/g, ' ')
        .trim();

    const compact = (value: string) => normalize(value).replace(/\\s+/g, '');
    const total = cards.length;

    function applySearch() {
      if (!(input instanceof HTMLInputElement)) return;

      const query = normalize(input.value);
      const compactQuery = compact(input.value);
      const terms = query.split(' ').filter(Boolean);
      let visibleCount = 0;

      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;

        const text = normalize(card.dataset.searchText || card.textContent || '');
        const compactText = compact(card.dataset.searchText || card.textContent || '');
        const matched =
          terms.length === 0 ||
          terms.every((term) => text.includes(term) || compactText.includes(term)) ||
          (compactQuery.length > 0 && compactText.includes(compactQuery));

        card.hidden = !matched;
        if (matched) visibleCount += 1;
      });

      if (meta) {
        meta.textContent = query ? `找到 ${visibleCount} / ${total} 篇文章` : `共 ${total} 篇文章`;
      }

      if (reset instanceof HTMLButtonElement) {
        reset.disabled = query.length === 0;
      }

      if (empty instanceof HTMLElement) {
        empty.hidden = query.length === 0 || visibleCount > 0;
      }
    }

    input?.addEventListener('input', applySearch);
    reset?.addEventListener('click', () => {
      if (!(input instanceof HTMLInputElement)) return;
      input.value = '';
      input.focus();
      applySearch();
    });
    applySearch();
  </script>
</BaseLayout>
