---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ColumnBrowser from '../../components/ColumnBrowser.astro';
import { getColumns, getPosts } from '../../lib/posts';

const columns = await getColumns();
const posts = await getPosts();
---

<BaseLayout title="专栏" description="按专栏浏览文章。">
  <ColumnBrowser
    allPosts={posts}
    columns={columns}
    posts={posts}
    title="全部笔记"
    subtitle="按 blog 目录组织的知识库视图。"
  />
</BaseLayout>
