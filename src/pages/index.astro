---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleSearchList from '../components/ArticleSearchList.astro';
import { getPosts } from '../lib/posts';
import { SITE } from '../site.config';

const posts = await getPosts();
---

<BaseLayout title="首页" description={SITE.description}>
  <section class="shell hero">
    <div>
      <p class="eyebrow">Markdown / Search / Deploy</p>
      <h1>记录个人技术积累与实践思考。</h1>
      <p>{SITE.description}</p>
    </div>
    <aside class="signal">
      <p>Astro content collections</p>
      <p>Pagefind static index</p>
      <p>RSS + sitemap + robots</p>
      <p>Cloudflare Pages ready</p>
    </aside>
  </section>

  <ArticleSearchList posts={posts} initialLimit={6} searchLabel="搜索技术笔记" listLabel="最新文章" />
</BaseLayout>
